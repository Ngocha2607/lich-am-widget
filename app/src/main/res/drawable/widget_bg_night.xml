<?xml version="1.0" encoding="utf-8"?>
<!-- Nền widget lúc đêm, dạng tấm 3D: cạnh dày phía dưới, mặt trời có ánh sáng loang từ trên và tối dần ở đáy,
     viền sáng vát cạnh, rồi quầng sáng / sao và mây khối. Lớp đầu là khung bo góc đầy đủ để clipToOutline cắt đúng. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle"><solid android:color="#FF070A1C" /><corners android:radius="28dp" /></shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF0E1430" android:centerColor="#FF1C2A52" android:endColor="#FF2A3C6E" android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/art_stars" android:gravity="top|start"
        android:width="340dp" android:height="90dp" android:top="4dp" android:left="12dp" />
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#33FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#24000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle"><stroke android:width="1dp" android:color="#2EFFFFFF" /><corners android:radius="28dp" /></shape>
    </item>
    <item android:drawable="@drawable/art_cloud" android:gravity="bottom|end"
        android:width="170dp" android:height="68dp" android:bottom="10dp" />
</layer-list>
