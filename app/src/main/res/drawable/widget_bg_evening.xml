<?xml version="1.0" encoding="utf-8"?>
<!-- Nền widget lúc chiều tà, dạng tấm 3D: cạnh dày phía dưới, mặt trời có ánh sáng loang từ trên và tối dần ở đáy,
     viền sáng vát cạnh, rồi quầng sáng / sao (mây nằm trong từng layout để đặt cỡ và chỗ riêng). Lớp đầu là khung bo góc đầy đủ để clipToOutline cắt đúng. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle"><solid android:color="#FF8A3E32" /><corners android:radius="28dp" /></shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF33285F" android:centerColor="#FF8E4A8A" android:endColor="#FFEE8A5A" android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.9" android:centerY="0.02" android:gradientRadius="75%"
                android:startColor="#80FFF4D2" android:endColor="#00FFF4D2" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#33FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#24000000" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle"><stroke android:width="1dp" android:color="#2EFFFFFF" /><corners android:radius="28dp" /></shape>
    </item>
</layer-list>
