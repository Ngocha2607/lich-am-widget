<?xml version="1.0" encoding="utf-8"?>
<!-- Tờ lịch 1×1 dạng tập lịch bloc 3D: ba tờ chồng phía dưới (độ dày) + mặt giấy ngà có ánh sáng xiên -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="3dp" android:right="3dp" android:top="3dp">
        <shape android:shape="rectangle"><solid android:color="#FFC2B49C" /><corners android:radius="15dp" /></shape>
    </item>
    <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="1.5dp">
        <shape android:shape="rectangle"><solid android:color="#FFD3C7B2" /><corners android:radius="15dp" /></shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="3dp">
        <shape android:shape="rectangle"><solid android:color="#FFE6DDCF" /><corners android:radius="15.5dp" /></shape>
    </item>
    <item android:bottom="4.5dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFFFF" android:endColor="#FFF1EBE1" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="4.5dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#00FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#14806A4A" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
