<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:clipToOutline="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_day"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/line_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        android:fontFamily="sans-serif-medium"
        android:textColor="#D9FFFFFF"
        android:textSize="11sp"
        android:shadowColor="#40000000"
        android:shadowDy="1"
        android:shadowRadius="2" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Trăng đúng tuần trăng của ngày âm (moon_0..moon_7), quầng sáng tràn ra lề -->
        <ImageView
            android:id="@+id/moon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="-5dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/moon_4"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/line_lunar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:textSize="19sp"
            android:includeFontPadding="false"
            android:shadowColor="#66000000"
            android:shadowDy="2"
            android:shadowRadius="4" />
    </LinearLayout>

    <TextView
        android:id="@+id/line_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#C7FFFFFF"
        android:textSize="11.5sp"
        android:shadowColor="#40000000"
        android:shadowDy="1"
        android:shadowRadius="2" />

    <TextView
        android:id="@+id/line_temp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:textSize="28sp"
        android:includeFontPadding="false"
        android:shadowColor="#66000000"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <TextView
        android:id="@+id/line_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill"
        android:paddingStart="9dp"
        android:paddingEnd="9dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFFFF"
        android:shadowColor="#73000000"
        android:shadowDy="1"
        android:shadowRadius="2"
        android:textSize="11.5sp" />
</LinearLayout>
