<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2×2 "Vầng trăng": thứ và ngày dương, trăng to, ngày âm chữ lớn, nhiệt độ.
     Gốc dùng id @android:id/background để launcher Android 12+ bo góc và cắt phần trang trí theo viền. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:clipToOutline="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_day">

    <!-- Mây cát tường dạng khối, cỡ và chỗ riêng cho từng cỡ widget -->
    <ImageView
        android:layout_width="96dp"
        android:layout_height="38dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-34dp"
        android:layout_marginBottom="6dp"
        android:src="@drawable/art_cloud"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="11dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/line_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:gravity="center"
            android:fontFamily="sans-serif-medium"
            android:textColor="#D9FFFFFF"
            android:textSize="10.5sp"
            android:shadowColor="#40000000"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <!-- Trăng hình cầu đúng tuần trăng (moon_0..7); không dùng lề âm để khỏi bị cắt -->
        <ImageView
            android:id="@+id/moon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="1dp"
            android:src="@drawable/moon_4"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/line_lunar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="13sp"
            android:autoSizeMaxTextSize="20sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:shadowColor="#66000000"
            android:shadowDy="2"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/line_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:textColor="#C7FFFFFF"
            android:textSize="11sp"
            android:shadowColor="#40000000"
            android:shadowDy="1"
            android:shadowRadius="2" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/line_temp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:textSize="17sp"
            android:shadowColor="#66000000"
            android:shadowDy="2"
            android:shadowRadius="4" />
    </LinearLayout>
</FrameLayout>
