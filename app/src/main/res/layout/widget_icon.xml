<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 1×1 "Lịch hôm nay": tập lịch bloc 3D cỡ một biểu tượng app, tự đổi ngày lúc 0h.
     Không clipToOutline: các tờ chồng phía dưới nằm ngoài viền mặt giấy. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/icon_page"
    android:orientation="vertical"
    android:paddingBottom="4.5dp">

    <!-- Thứ trên gáy đỏ, nằm dưới hai vòng gáy -->
    <TextView
        android:id="@+id/icon_head"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.30"
        android:background="@drawable/icon_head"
        android:gravity="bottom|center_horizontal"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        android:textColor="#FFFFFFFF"
        android:shadowColor="#73501014"
        android:shadowDy="1"
        android:shadowRadius="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="7sp"
        android:autoSizeMaxTextSize="11sp" />

    <!-- Ngày dương in chìm (letterpress): chàm đêm, đỏ son vào Chủ nhật và ngày lễ, rằm, mùng 1 -->
    <TextView
        android:id="@+id/icon_day"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.48"
        android:background="@drawable/icon_day_bg"
        android:gravity="center"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingTop="2dp"
        android:fontFamily="serif"
        android:textColor="#FF1C2A52"
        android:shadowColor="#E6FFFFFF"
        android:shadowDy="1"
        android:shadowRadius="0.5"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="46sp" />

    <!-- Ngày âm kèm trăng 3D đúng tuần trăng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.22"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="2dp">

        <ImageView
            android:id="@+id/icon_moon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/moonp_4"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/icon_lunar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:textColor="#FF8A7A62"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
